{
  "name": "@dasasian/gdocs-mcp",
  "mcpName": "io.github.dasasian/gdocs-mcp",
  "version": "0.2.0",
  "description": "An MCP server that lets an AI agent treat a Google Doc like a local file — read, edit, review suggestions, and manage comments, across multiple Google accounts.",
  "license": "MIT",
  "author": "Dasasian",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-docs",
    "google-drive",
    "claude",
    "claude-code",
    "ai-agent",
    "llm",
    "documents",
    "markdown"
  ],
  "homepage": "https://dasasian.com/gdocs-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasasian/gdocs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dasasian/gdocs-mcp/issues"
  },
  "bin": {
    "gdocs-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
